# Mai Ru app environment. Copy to .env and fill in. Never commit .env.
# Base URL of the backend API (restart with `npx expo start -c` after changing it):
#   Android emulator, backend on the same PC ... http://10.0.2.2:3000/api/v1
#   iOS simulator, same Mac ................... http://localhost:3000/api/v1
#   Real phone, same Wi-Fi .................... http://<machine LAN IP>:3000/api/v1
#   Real phone, shared server over Tailscale .. http://100.92.196.84:3000/api/v1 (Tailscale on)
#   Through Nginx (port 80, 6 MB bodies) ...... http://<host>/api/v1
# Plain HTTP works in Expo Go; a development or release build needs HTTPS or ATS/cleartext exceptions.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000/api/v1
# 1 = run against the built-in mock data, 0 = call the real backend.
EXPO_PUBLIC_USE_MOCKS=0
# Optional mock failure: "match" (recommendations fail) or "expire" (next call returns 401 once).
EXPO_PUBLIC_MOCK_FAIL=
